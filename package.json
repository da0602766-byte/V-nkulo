{
  "name": "adote-gestao",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "recovery:local": "node scripts/recovery/restore.mjs",
    "install:ci": "node scripts/run.mjs install:ci",
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "start": "node scripts/run.mjs start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "node scripts/run.mjs lint",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "audit:source": "node scripts/audit/source-inventory.mjs",
    "db:generate": "node scripts/run.mjs db:generate"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "drizzle-orm": "0.45.2",
    "jsqr": "^1.4.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sql.js": "1.15.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.5",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "wrangler": "$wrangler",
    "vinext": { "image-size": "2.0.4" },
    "@esbuild-kit/core-utils": { "esbuild": "0.25.12" }
  },
  "type": "module",
  "displayName": "VÍNKULO — Gestão de Comunidades"
}
